# Copy to .env (or paste the values into Dokploy's Environment tab).
# Fill in your own values — the real .env is gitignored and never committed.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Hostname Traefik serves cezar on. DNS A/AAAA must point at this server.
CEZAR_DOMAIN=cezar.example.com

# HTTP Basic Auth login name (an email works fine).
CEZAR_AUTH_USER=admin

# HTTP Basic Auth password hash. Must be a HASH, not the password.
# Traefik accepts $apr1$ (MD5), {SHA} or $2y$ (bcrypt). Generate with:
#     openssl passwd -apr1 'your-password'
# In a plain .env keep the SINGLE QUOTES so the "$" stay literal:
CEZAR_AUTH_HASH='$apr1$REPLACE$REPLACE'

# ---------------------------------------------------------------------------
# OPTIONAL  (defaults shown)
# ---------------------------------------------------------------------------

# Host directory for your git checkouts (bind-mounted to /srv/cezar/repos).
CEZAR_REPOS_PATH=/srv/cezar/repos

# Traefik router/middleware/service name prefix. Keep "cezar" for a single
# instance; on a second instance on the same Dokploy use a distinct value
# (e.g. cezartest) so the global Traefik names don't collide.
CEZAR_ROUTER_PREFIX=cezar

# Image build knobs.
CEZAR_VERSION=latest
CLAUDE_CODE_VERSION=latest
CEZAR_UID=1001
CEZAR_GID=1001
CEZAR_IMAGE=cezar-cockpit:latest
CEZAR_CONTAINER_NAME=cezar

# Git identity used for the seeded workspace commit.
CEZAR_GIT_NAME=cezar
CEZAR_GIT_EMAIL=cezar@local

# Container timezone.
TZ=UTC

# Traefik wiring (Dokploy defaults shown).
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT_WEB=web
TRAEFIK_ENTRYPOINT_SECURE=websecure
